FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

WORKDIR /app

# Install system dependencies for OpenCV headless and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY atelier-agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY atelier-agent/src/ ./src/
COPY atelier-agent/pyproject.toml .

EXPOSE 8080

CMD exec uvicorn src.main:app --host 0.0.0.0 --port ${PORT}
