# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.cs text eol=crlf diff=csharp
*.razor text eol=crlf diff=html
*.py text eol=lf diff=python
*.sh text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.zip binary
