@page "/"
@namespace Atelier.Web.Components.Pages
@using Atelier.Web.Components.Shared
@using Atelier.Web.Components.Layout
@inject IAtelierAgentClient AgentClient
@inject IWebHostEnvironment Env

<PageTitle>@Loc["Atelier — Studio Master Perspective AI"]</PageTitle>

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <div class="eyebrow">@Loc["Studio"]</div>
        <h1 style="font-size: var(--t-2xl); margin: 4px 0 0;">@StepHeading</h1>
        <p class="text-body-secondary mb-0" style="font-size: var(--t-sm);">@StepSubheading</p>
    </div>

    @* Levels, not people. The profile is a difficulty setting: it decides the rubric's register
       and the tone of the critique, and nothing about it is a person. *@
    <div class="d-flex align-items-center gap-2">
        <span class="eyebrow">@Loc["Level"]</span>
        <div class="btn-group btn-group-sm" role="group">
            <button type="button" class="btn @(CurrentStudentId == BasicId ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SelectLevelAsync(BasicId)">@Loc["Basic"]</button>
            <button type="button" class="btn @(CurrentStudentId == AdvancedId ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => SelectLevelAsync(AdvancedId)">@Loc["advanced"]</button>
        </div>
    </div>
</div>

@* ---------------------------------------------------------------- step 1: the drawing *@
@if (CurrentStep == 0)
{
    @* Above the grid, because it is a reply to what the reader just did. Without it a refused
       upload produced no visible response at all. *@
    <div class="mb-4">@RenderStatus</div>

    <div class="row g-4">
        <div class="col-lg-8">
            <section class="card p-4 mb-4">
                <div class="eyebrow mb-3">@Loc["Calibration samples"]</div>
                <div class="sample-grid">
                    @foreach (var s in Samples)
                    {
                        <button type="button"
                                class="sample-card @(SelectedSample == s.File ? "is-selected" : "")"
                                @onclick="() => LoadSampleDrawingAsync(s.File)">
                            <img src="/samples/@s.File" alt="@s.File" loading="lazy" />
                            <span class="sys">@Loc[s.SystemKey]</span>
                            <span class="name">@Loc[s.LabelKey]</span>
                        </button>
                    }
                </div>
            </section>

            <section class="card p-4">
                <div class="eyebrow mb-3">@Loc["Or upload your own drawing"]</div>
                <div class="dropzone">
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*" />
                    <p class="mb-0 mt-3" style="font-size: var(--t-sm);">
                        @Loc["Atelier looks at the photograph first and decides which system of representation it is, before measuring anything."]
                    </p>
                </div>
            </section>
        </div>

        <div class="col-lg-4">
            <ExerciseHistory StudentId="@CurrentStudentId" Revision="HistoryRevision" />
        </div>
    </div>
}

@* ---------------------------------------------------------------- step 2: the context *@
@if (CurrentStep == 1)
{
    <div class="row g-4">
        <div class="col-lg-5">
            @if (AskData is not null)
            {
                <CollaborativeDialog Mode="ask" AskData="AskData" StudentId="@CurrentStudentId"
                                     OnAskCompleted="HandleAskCompleted" />
            }
        </div>
        <div class="col-lg-7">
            @RenderMeasurement
        </div>
    </div>
}

@* ---------------------------------------------------------------- step 3: the critique *@
@if (CurrentStep == 2)
{
    <div class="row g-4">
        <div class="col-lg-7">
            @RenderMeasurement
        </div>
        <div class="col-lg-5">
            @if (IsAnalyzing)
            {
                <section class="card p-5 text-center">
                    <div class="spinner-border text-primary mb-3 mx-auto" role="status"></div>
                    <h5>@Loc["Studio Master is examining drawing geometry & formulating critique..."]</h5>
                    <p class="text-body-secondary small mb-0">@Loc["Invoking Gemini Flash on Vertex AI with level-aware rubric calibration."]</p>
                </section>
            }
            else if (CurrentCritique is not null)
            {
                <TwoPlaneCritique Critique="CurrentCritique" />

                @if (ExerciseSaved)
                {
                    <CollaborativeDialog Mode="feedback" ExerciseId="@CurrentExerciseId" StudentId="@CurrentStudentId" />
                }

                <button type="button" class="btn btn-outline-secondary w-100 mt-3" @onclick="StartOverAsync">
                    @Loc["Analyse another drawing"]
                </button>
            }
        </div>
    </div>
}

@code {
    private const string BasicId = "level-basic";
    private const string AdvancedId = "level-advanced";

    /// <summary>Deep link from the gallery: /?sample=07_isometric_error_6deg.png</summary>
    [SupplyParameterFromQuery(Name = "sample")]
    public string? SampleFromQuery { get; set; }

    [CascadingParameter]
    private MainLayout? Shell { get; set; }

    private sealed record SampleDef(string File, string LabelKey, string SystemKey, string? Axonometric, bool Orthographic, int KPoints);

    /// <summary>
    /// The calibration set, and which reference each drawing is measured against. This table is
    /// the single place that knows: measuring an isometric cube as if it were perspective would
    /// find a vanishing point among edges that were never meant to meet.
    /// </summary>
    private static readonly SampleDef[] Samples =
    [
        new("01_1point_perfect.png",            "1-Point Perspective (Perfect 0° error)",      "Conic", null, false, 1),
        new("02_1point_error_4deg.png",         "1-Point Perspective (Slight 4° error)",       "Conic", null, false, 1),
        new("03_1point_error_9deg.png",         "1-Point Perspective (Deliberate 9° error)",   "Conic", null, false, 1),
        new("04_2point_perfect.png",            "2-Point Perspective (Perfect F1/F2)",         "Conic", null, false, 2),
        new("05_2point_error_6deg.png",         "2-Point Perspective (F1 Drift 6° error)",     "Conic", null, false, 2),
        new("06_isometric_perfect.png",         "Isometric (axes exact)",                      "Axonometric", "isometric", false, 0),
        new("07_isometric_error_6deg.png",      "Isometric (X axis set 6° wrong)",             "Axonometric", "isometric", false, 0),
        new("08_cavalier_perfect.png",          "Cavalier (45° receding axis)",                "Axonometric", "cavalier",  false, 0),
        new("09_diedrico_perfect.png",          "Orthographic plate (views correspond)",       "Orthographic", null, true, 0),
        new("10_diedrico_error_18px.png",       "Orthographic plate (plan 18 px out)",         "Orthographic", null, true, 0),
        new("11_diedrico_vertice_huerfano.png", "Orthographic plate (a corner never carried across)", "Orthographic", null, true, 0),
    ];

    private string CurrentStudentId { get; set; } = BasicId;
    private StudentProfileDto? CurrentStudent { get; set; }
    private AskPromptDataDto? AskData { get; set; }
    private string SelectedSample { get; set; } = string.Empty;

    private string? CurrentBase64 { get; set; }
    private GeometryAnalysisResultDto? CurrentGeometry { get; set; }
    /// <summary>Set instead of <see cref="CurrentGeometry"/> when the drawing is a parallel
    /// projection. Never both: the two are different measurements of different things, and a
    /// screen showing one while holding the other is how a stale reading gets read as fresh.</summary>
    private AxonometricAnalysisResultDto? CurrentAxonometry { get; set; }
    /// <summary>Set instead of the other two when the drawing is a Monge plate.</summary>
    private DihedralAnalysisResultDto? CurrentDihedral { get; set; }
    /// <summary>True when one of the three analyses produced something to critique.</summary>
    private bool HasAnalysis =>
        CurrentGeometry is not null || CurrentAxonometry is not null || CurrentDihedral is not null;

    private CritiqueOutputDto? CurrentCritique { get; set; }
    private string CurrentExerciseId { get; set; } = string.Empty;
    /// <summary>Whether the agent actually stored this exercise. The feedback step is only
    /// offered when it did — asking for feedback on something that was never saved is how the
    /// screen came to report a profile as adapted over an empty database.</summary>
    private bool ExerciseSaved { get; set; }
    /// <summary>The agent did not answer. Said out loud, because the alternative was a page of
    /// hardcoded numbers that looked exactly like a working system.</summary>
    private bool AgentUnavailable { get; set; }
    /// <summary>Why the gate refused this photograph, when it did.</summary>
    private string? NotAnExercise { get; set; }
    /// <summary>What the router decided from the student's own words, and where it came from.</summary>
    private RoutingResultDto? Routing { get; set; }
    /// <summary>True when what the student wrote implies a different perspective from the one
    /// their drawing was measured as. Reported, never silently acted on.</summary>
    private bool IntentMismatch { get; set; }

    private bool IsAnalyzing { get; set; }
    /// <summary>Bumped after a save so the history panel refetches rather than showing a stale list.</summary>
    private int HistoryRevision { get; set; }

    private int CurrentStep { get; set; }

    private string StepHeading => CurrentStep switch
    {
        1 => Loc["Before we look, two questions"],
        2 => Loc["What the measurements say"],
        _ => Loc["Choose a drawing"],
    };

    private string StepSubheading => CurrentStep switch
    {
        1 => Loc["Your answers set the register of the critique. They never change the measurement."],
        2 => Loc["The geometry measures, the AI teaches."],
        _ => Loc["Pick a calibration sample or upload a photograph of your own work."],
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentAsync(CurrentStudentId);

        // A deep link from the gallery names its own sample and is analysed straight away, which
        // is the point of following the link. Without one the page stays on step 1 and waits:
        // analysing something nobody chose would skip the first step of a three-step flow and
        // land the reader on "Context" for a drawing they never picked.
        var requested = Samples.FirstOrDefault(s => s.File == SampleFromQuery);
        if (requested is not null)
        {
            await LoadSampleDrawingAsync(requested.File);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The step indicator belongs in the top bar, which the layout owns.
        Shell?.SetTopBar(@<StepIndicator Current="CurrentStep" OnStepSelected="GoToStepAsync" />);
    }

    private Task GoToStepAsync(int step)
    {
        if (step < CurrentStep) CurrentStep = step;
        return Task.CompletedTask;
    }

    private async Task SelectLevelAsync(string studentId)
    {
        CurrentStudentId = studentId;
        await LoadStudentAsync(studentId);
        CurrentStep = 0;
        ClearAnalysis();
    }

    private async Task LoadStudentAsync(string studentId)
    {
        var students = await AgentClient.GetStudentsAsync();
        CurrentStudent = students.FirstOrDefault(s => s.StudentId == studentId) ?? new StudentProfileDto
        {
            StudentId = studentId,
            Name = studentId == AdvancedId ? "advanced" : "basic",
            Level = studentId == AdvancedId ? "advanced" : "beginner"
        };
        await ReloadAskPrompt();
    }

    private async Task ReloadAskPrompt()
    {
        AskData = await AgentClient.GetAskPromptAsync(CurrentStudentId);
    }

    private async Task LoadSampleDrawingAsync(string filename)
    {
        // Read the actual calibration PNG and analyse it. This used to pass string.Empty; the
        // agent rejected it with 400, the client silently substituted hardcoded constants, and
        // every sample produced identical output. The measured number has to move when the
        // drawing does, which is the whole point of a calibration set.
        var def = Samples.FirstOrDefault(s => s.File == filename) ?? Samples[0];
        SelectedSample = def.File;
        IsAnalyzing = true;
        ClearAnalysis();

        var path = Path.Combine(Env.WebRootPath, "samples", def.File);
        CurrentBase64 = File.Exists(path)
            ? Convert.ToBase64String(await File.ReadAllBytesAsync(path))
            : string.Empty;

        if (def.Orthographic)
        {
            CurrentDihedral = await AgentClient.AnalyzeDihedralAsync(CurrentBase64);
            AgentUnavailable = CurrentDihedral is null;
        }
        else if (def.Axonometric is { Length: > 0 } system)
        {
            CurrentAxonometry = await AgentClient.AnalyzeAxonometricAsync(CurrentBase64, system);
            AgentUnavailable = CurrentAxonometry is null;
        }
        else
        {
            CurrentGeometry = await AgentClient.AnalyzeGeometryAsync(CurrentBase64, def.KPoints, generateOverlay: true);
            AgentUnavailable = CurrentGeometry is null;
        }

        IsAnalyzing = false;
        if (HasAnalysis) CurrentStep = 1;
    }

    /// <summary>
    /// Drop every measurement from the previous drawing. Leaving one behind is how a refused
    /// upload came to display the confidence score of the drawing before it.
    /// </summary>
    private void ClearAnalysis()
    {
        CurrentGeometry = null;
        CurrentAxonometry = null;
        CurrentDihedral = null;
        CurrentCritique = null;
        ExerciseSaved = false;
        IntentMismatch = false;
        NotAnExercise = null;
        AgentUnavailable = false;
    }

    private async Task StartOverAsync()
    {
        CurrentStep = 0;
        ClearAnalysis();
        await ReloadAskPrompt();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        CurrentBase64 = Convert.ToBase64String(ms.ToArray());

        SelectedSample = string.Empty;
        IsAnalyzing = true;
        ClearAnalysis();

        // The gate first. A photograph that is not an exercise — a page of text, a blank sheet, a
        // picture of the cat — would otherwise go through RANSAC, produce a vanishing point from
        // whatever edges exist, and earn a critique about line weight. Measuring the wrong thing
        // carefully is worse than not measuring it.
        var gate = await AgentClient.ClassifyDrawingAsync(CurrentBase64);
        if (gate is { IsExercise: false })
        {
            NotAnExercise = gate.Reasoning;
            IsAnalyzing = false;
            return;
        }

        // The gate does not only decide whether to measure; it decides what to measure against.
        // Only a gate that actually looked gets to make that call — the fallback stays conic,
        // which is the behaviour this page has always had.
        if (gate is { Source: "vertex", Projection: "orthographic" })
        {
            CurrentDihedral = await AgentClient.AnalyzeDihedralAsync(CurrentBase64);
            AgentUnavailable = CurrentDihedral is null;
        }
        else if (gate is { Source: "vertex", Projection: "axonometric" } && gate.AxonometricSystem is { Length: > 0 } system)
        {
            CurrentAxonometry = await AgentClient.AnalyzeAxonometricAsync(CurrentBase64, system);
            AgentUnavailable = CurrentAxonometry is null;
        }
        else
        {
            var kPoints = gate is { Source: "vertex", RecommendedK: 1 or 2 }
                ? gate.RecommendedK
                : (CurrentStudent?.Level == "beginner" ? 1 : 2);

            CurrentGeometry = await AgentClient.AnalyzeGeometryAsync(CurrentBase64, kPoints, generateOverlay: true);
            AgentUnavailable = CurrentGeometry is null;
        }

        IsAnalyzing = false;
        if (HasAnalysis) CurrentStep = 1;
    }

    private async Task HandleAskCompleted((string Intent, string Difficulty) context)
    {
        if (!HasAnalysis || CurrentStudent == null) return;

        CurrentStep = 2;
        IsAnalyzing = true;
        ExerciseSaved = false;

        // Ask the router what the student's own words imply, and compare it with what the drawing
        // was actually measured as.
        //
        // The words do NOT win. An earlier version re-measured on the router's say-so, and a
        // one-point box described as "the corner of a building" came back as two-point: 29.9
        // degrees of average error in a drawing that has one vanishing point. The measurement is
        // the evidence and the description is a claim, so the claim does not overrule it. What
        // the disagreement is good for is saying so.
        Routing = await AgentClient.RouteIntentAsync(context.Intent, CurrentStudent.Level);
        IntentMismatch = Routing is { Source: "gemma", RecommendedK: 1 or 2 }
                         && CurrentGeometry is not null
                         && Routing.RecommendedK != CurrentGeometry.KRequested;

        var critiqueReq = new CritiqueRequestDto
        {
            // Exactly one of the three. The agent refuses a request carrying more, because the
            // anti-hallucination whitelist would then be the union of unrelated sets of numbers.
            Geometry = CurrentGeometry,
            Axonometry = CurrentAxonometry,
            Dihedral = CurrentDihedral,
            Student = CurrentStudent,
            // The drawing itself. Plane B asks the model about line weight and spatial clarity;
            // without the image the validator rejects those observations and falls back to the
            // template — which is what happened, silently, until this line.
            ImageBase64 = CurrentBase64,
            StudentIntent = context.Intent,
            StudentDifficulty = context.Difficulty,
            // Off by default: a cached critique cannot be about the drawing just uploaded.
            UseCache = false
        };

        var response = await AgentClient.GenerateCritiqueAsync(critiqueReq);
        CurrentCritique = response?.Critique;
        AgentUnavailable = CurrentCritique is null;

        // Persist the exercise and adopt the id the agent gives back. This is what makes the
        // feedback step real: the id used to be minted here and never sent, so every thumbs-up
        // arrived for an exercise the agent had never heard of.
        if (CurrentCritique is not null)
        {
            var saved = await AgentClient.SaveExerciseAsync(new ExerciseRecordDto
            {
                ExerciseId = $"ex-ui-{Guid.NewGuid().ToString("N")[..8]}",
                StudentId = CurrentStudent.StudentId,
                Source = "upload",
                StudentIntent = context.Intent,
                StudentDifficulty = context.Difficulty,
                GeometryAnalysis = CurrentGeometry,
                AxonometricAnalysis = CurrentAxonometry,
                DihedralAnalysis = CurrentDihedral,
                Critique = CurrentCritique
            });

            CurrentExerciseId = saved?.ExerciseId ?? string.Empty;
            ExerciseSaved = saved is not null;
            if (ExerciseSaved) HistoryRevision++;
        }

        IsAnalyzing = false;
    }

    /// <summary>
    /// What just happened: a refusal, an unreachable agent, or work in progress.
    ///
    /// Rendered on **every** step, not only the ones that show a measurement. It used to live
    /// inside <see cref="RenderMeasurement"/> alone, and the consequence was that a photograph the
    /// gate refused produced nothing at all on screen: the refusal sets no analysis, so the page
    /// stayed on step one, which had no place to say so. Choosing a sample looked equally dead for
    /// the two seconds the engine took. Silence is the one answer this page must never give.
    /// </summary>
    private RenderFragment RenderStatus => @<text>
        @if (NotAnExercise is not null)
        {
            <div class="alert alert-warning border-0 rounded-4">
                <strong>@Loc["This does not look like a perspective exercise."]</strong>
                <div class="small mt-1">@NotAnExercise</div>
                <div class="small mt-2 text-body-secondary">
                    @Loc["Nothing was measured. Upload a construction from one of the systems of representation — conic, axonometric or orthographic — and Atelier will look again."]
                </div>
            </div>
        }
        @if (AgentUnavailable)
        {
            <div class="alert alert-danger border-0 rounded-4">
                <strong>@Loc["The analysis service did not answer."]</strong>
                <div class="small mt-1">
                    @Loc["Nothing is shown rather than something invented. This page used to fill in hardcoded numbers here, which looked exactly like a working system."]
                </div>
            </div>
        }
        @if (IsAnalyzing && !HasAnalysis)
        {
            <section class="card p-4 d-flex flex-row align-items-center gap-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <p class="text-body-secondary mb-0">@Loc["Analyzing geometry with deterministic OpenCV engine..."]</p>
            </section>
        }
    </text>;

    /// <summary>
    /// The measurement panel, shared by steps 2 and 3. Exactly one viewer renders, because
    /// exactly one analysis exists.
    /// </summary>
    private RenderFragment RenderMeasurement => @<text>
        @RenderStatus
        @if (CurrentGeometry is not null)
        {
            <OverlayViewer Geometry="CurrentGeometry" OriginalImageBase64="@CurrentBase64" />
        }
        else if (CurrentAxonometry is not null)
        {
            <AxonometricViewer Analysis="CurrentAxonometry" OriginalImageBase64="@CurrentBase64" />
        }
        else if (CurrentDihedral is not null)
        {
            <DihedralViewer Analysis="CurrentDihedral" OriginalImageBase64="@CurrentBase64" />
        }
        @if (IntentMismatch && Routing is not null && CurrentGeometry is not null)
        {
            <div class="alert alert-info border-0 rounded-4 py-2">
                <strong>@Loc["Your description and your drawing do not match."]</strong>
                <div class="small mt-1">
                    @(Loc["You described a {0} — {1} This drawing was measured as {2}-point, which is what it looks like. Nothing was changed; worth a second look at either the drawing or the description.", Routing.ExerciseType, Routing.Reasoning, CurrentGeometry.KRequested])
                </div>
            </div>
        }
    </text>;
}
