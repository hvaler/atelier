@page "/"
@namespace Atelier.Web.Components.Pages
@using Atelier.Web.Components.Shared
@inject IAtelierAgentClient AgentClient
@inject IWebHostEnvironment Env

<PageTitle>@Loc["Atelier — Studio Master Perspective AI"]</PageTitle>

<div class="container-xl py-4">
    <!-- Top Studio Master Bar -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary-subtle border-opacity-25">
        <div>
            <h2 class="fw-bold text-body mb-0">
                <span class="text-primary">Atelier</span> @Loc["Studio"]
            </h2>
            <p class="text-body-secondary small mb-0">
                @Loc["The geometry measures, the AI teaches, the student grows."]
            </p>
        </div>

        <!-- Student Switcher -->
        <div class="d-flex align-items-center gap-3 bg-body-tertiary p-2 rounded-4 border border-secondary-subtle border-opacity-25 shadow-sm">
            <span class="text-body-secondary small ps-2">@Loc["Active Student:"]</span>
            <div class="btn-group btn-group-sm" role="group">
                <button type="button" class="btn @(CurrentStudentId == "young-tester-01" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3" @onclick='() => SelectStudent("young-tester-01")'>
                    @Loc["Young Tester (Age 9)"]
                </button>
                <button type="button" class="btn @(CurrentStudentId == "sofia-01" ? "btn-primary fw-bold" : "btn-outline-secondary") rounded-pill px-3" @onclick='() => SelectStudent("sofia-01")'>
                    @Loc["Sofia (Animation Adv.)"]
                </button>
            </div>
            <span class="badge @(CurrentStudent?.Level == "beginner" ? "bg-info text-dark" : "bg-warning text-dark") rounded-pill px-3 py-2">
                @(Loc[CurrentStudent?.Level ?? "beginner"].Value.ToUpperInvariant())
            </span>
        </div>
    </div>

    <!-- Main Studio Workspace Grid -->
    <div class="row g-4">
        <!-- Left Column: Drawing Setup & Collaboration -->
        <div class="col-lg-5">
            <!-- Source Picker Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body-tertiary text-body mb-4">
                <h5 class="fw-bold text-body mb-3">@Loc["📂 Select Perspective Drawing"]</h5>

                <div class="mb-3">
                    <label class="form-label text-body-secondary small">@Loc["Pre-Calibrated Golden Sample:"]</label>
                    <select class="form-select bg-body-secondary text-body border-secondary-subtle" @onchange="OnSampleSelected">
                        <option value="01_1point_perfect.png">@Loc["1-Point Perspective (Perfect 0° error)"]</option>
                        <option value="02_1point_error_4deg.png">@Loc["1-Point Perspective (Slight 4° error)"]</option>
                        <option value="03_1point_error_9deg.png">@Loc["1-Point Perspective (Deliberate 9° error)"]</option>
                        <option value="04_2point_perfect.png">@Loc["2-Point Perspective (Perfect F1/F2)"]</option>
                        <option value="05_2point_error_6deg.png">@Loc["2-Point Perspective (F1 Drift 6° error)"]</option>
                        <option value="06_isometric_perfect.png">@Loc["Isometric (axes exact)"]</option>
                        <option value="07_isometric_error_6deg.png">@Loc["Isometric (X axis set 6° wrong)"]</option>
                        <option value="08_cavalier_perfect.png">@Loc["Cavalier (45° receding axis)"]</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label text-body-secondary small">@Loc["Or Upload Student Drawing Photo:"]</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control bg-body-secondary text-body border-secondary-subtle" accept="image/*" />
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-secondary">
                        @TargetModeLabel
                    </span>
                    <button class="btn btn-outline-info btn-sm rounded-pill" @onclick="ReloadAskPrompt">
                        @Loc["Refresh Questions"]
                    </button>
                </div>
            </div>

            <!-- Verb 1: ASK Clarifying Questions Card -->
            @if (AskData != null && !AnalysisCompleted)
            {
                <CollaborativeDialog Mode="ask"
                                     AskData="AskData"
                                     StudentId="@CurrentStudentId"
                                     OnAskCompleted="HandleAskCompleted" />
            }

            <!-- Verb 3: CAPTURE Feedback Card. Only offered when the exercise was actually
                 stored — asking for feedback on something that does not exist is how the screen
                 came to report a profile as adapted over an empty database. -->
            @if (AnalysisCompleted && ExerciseSaved)
            {
                <CollaborativeDialog Mode="feedback"
                                     ExerciseId="@CurrentExerciseId"
                                     StudentId="@CurrentStudentId" />
            }
        </div>

        <!-- Right Column: Multimodal Geometric Overlay & Two-Plane Critique -->
        <div class="col-lg-7">
            <!-- Multimodal Overlay (The Star Feature). Only when there is a measurement to show:
                 with the panel always rendered, a refused upload still displayed the header, the
                 confidence from the *previous* drawing and the severity legend over a page of
                 text — a screen that says "nothing was measured" while looking like it did. -->
            @if (CurrentGeometry is not null)
            {
                <OverlayViewer Geometry="CurrentGeometry" OriginalImageBase64="@CurrentBase64" />
            }
            else if (CurrentAxonometry is not null)
            {
                <AxonometricViewer Analysis="CurrentAxonometry" OriginalImageBase64="@CurrentBase64" />
            }

            <!-- Two-Plane Pedagogical Critique -->
            @* The gate refused this photograph. Said plainly, with the model's own reason, because
               "we did not measure this" is a useful answer and a silent zero is not. *@
            @if (NotAnExercise is not null)
            {
                <div class="alert alert-warning border-0 rounded-4">
                    <strong>@Loc["This does not look like a perspective exercise."]</strong>
                    <div class="small mt-1">@NotAnExercise</div>
                    <div class="small mt-2 text-muted">
                        @Loc["Nothing was measured. Upload a drawing with construction lines running to a vanishing point and Atelier will look again."]
                    </div>
                </div>
            }
            @* The student's description and their drawing disagree. Neither is corrected behind
               their back: the drawing was measured as drawn, and the difference is named. *@
            @if (IntentMismatch && Routing is not null && CurrentGeometry is not null)
            {
                <div class="alert alert-info border-0 rounded-4 py-2">
                    <strong>@Loc["Your description and your drawing do not match."]</strong>
                    <div class="small mt-1">
                        @(Loc["You described a {0} — {1} This drawing was measured as {2}-point, which is what it looks like. Nothing was changed; worth a second look at either the drawing or the description.", Routing.ExerciseType, Routing.Reasoning, CurrentGeometry.KRequested])
                    </div>
                </div>
            }
            @if (AgentUnavailable)
            {
                <div class="alert alert-danger border-0 rounded-4">
                    <strong>@Loc["The analysis service did not answer."]</strong>
                    <div class="small mt-1">
                        @Loc["Nothing is shown rather than something invented. This page used to fill in hardcoded numbers here, which looked exactly like a working system."]
                    </div>
                </div>
            }
            @if (IsAnalyzing)
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 bg-body-tertiary text-center text-body">
                    <div class="spinner-border text-primary mb-3 mx-auto" role="status"></div>
                    <h5>@Loc["Studio Master is examining drawing geometry & formulating critique..."]</h5>
                    <p class="text-body-secondary small">@Loc["Invoking Gemini Flash on Vertex AI with level-aware rubric calibration."]</p>
                </div>
            }
            else if (CurrentCritique != null)
            {
                <TwoPlaneCritique Critique="CurrentCritique" />
            }
        </div>
    </div>
</div>

@code {
    private string CurrentStudentId { get; set; } = "young-tester-01";
    private StudentProfileDto? CurrentStudent { get; set; }
    private AskPromptDataDto? AskData { get; set; }

    private string? CurrentBase64 { get; set; }
    private GeometryAnalysisResultDto? CurrentGeometry { get; set; }
    /// <summary>Set instead of <see cref="CurrentGeometry"/> when the drawing is a parallel
    /// projection. Never both: the two are different measurements of different things, and a
    /// screen showing one while holding the other is how a stale reading gets read as fresh.</summary>
    private AxonometricAnalysisResultDto? CurrentAxonometry { get; set; }
    /// <summary>True when either analysis produced something to critique.</summary>
    private bool HasAnalysis => CurrentGeometry is not null || CurrentAxonometry is not null;
    private CritiqueOutputDto? CurrentCritique { get; set; }
    private string CurrentExerciseId { get; set; } = string.Empty;
    /// <summary>Whether the agent actually stored this exercise. The feedback step is only
    /// offered when it did — asking for feedback on something that was never saved is how the
    /// screen came to report a profile as adapted over an empty database.</summary>
    private bool ExerciseSaved { get; set; }
    /// <summary>The agent did not answer. Said out loud, because the alternative was a page of
    /// hardcoded numbers that looked exactly like a working system.</summary>
    private bool AgentUnavailable { get; set; }
    /// <summary>Why the gate refused this photograph, when it did.</summary>
    private string? NotAnExercise { get; set; }
    /// <summary>What the router decided from the student's own words, and where it came from.</summary>
    private RoutingResultDto? Routing { get; set; }
    /// <summary>True when what the student wrote implies a different perspective from the one
    /// their drawing was measured as. Reported, never silently acted on.</summary>
    private bool IntentMismatch { get; set; }

    /// <summary>The perspective the rubric will expect for this student, in their language.
    /// Built here rather than inline because a nested localiser lookup inside a Razor
    /// conditional is unreadable in markup.</summary>
    private string TargetModeLabel
    {
        get
        {
            // Once a parallel projection is on screen, "1-point (k=1)" is describing a different
            // drawing. The badge names what is actually being measured against, not what the
            // student's profile level would have implied.
            if (CurrentAxonometry is not null)
            {
                var systemKey = CurrentAxonometry.System switch
                {
                    "dimetric" => "Dimetric projection",
                    "cavalier" => "Cavalier projection",
                    _ => "Isometric projection",
                };
                return string.Format(Loc["Measured against: {0}"], Loc[systemKey]);
            }

            return string.Format(
                Loc["Target Mode: {0}"],
                CurrentStudent?.Level == "beginner" ? Loc["1-Point (k=1)"] : Loc["2-Point (k=2)"]);
        }
    }

    private bool IsAnalyzing { get; set; }
    private bool AnalysisCompleted { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentAsync(CurrentStudentId);
        await LoadSampleDrawingAsync("01_1point_perfect.png");
    }

    private async Task SelectStudent(string studentId)
    {
        CurrentStudentId = studentId;
        await LoadStudentAsync(studentId);
        AnalysisCompleted = false;
        CurrentCritique = null;
        await ReloadAskPrompt();
    }

    private async Task LoadStudentAsync(string studentId)
    {
        var students = await AgentClient.GetStudentsAsync();
        CurrentStudent = students.FirstOrDefault(s => s.StudentId == studentId) ?? new StudentProfileDto
        {
            StudentId = studentId,
            Name = studentId.Contains("sofia") ? "Sofia" : "Young Tester (Age 9)",
            Level = studentId.Contains("sofia") ? "advanced" : "beginner"
        };
        await ReloadAskPrompt();
    }

    private async Task ReloadAskPrompt()
    {
        AskData = await AgentClient.GetAskPromptAsync(CurrentStudentId);
    }

    private async Task OnSampleSelected(ChangeEventArgs e)
    {
        var filename = e.Value?.ToString() ?? "01_1point_perfect.png";
        await LoadSampleDrawingAsync(filename);
    }

    private async Task LoadSampleDrawingAsync(string filename)
    {
        // Read the actual calibration PNG and analyse it.
        //
        // This used to pass string.Empty. The agent rejects an empty image with 400, the client
        // silently substituted hardcoded constants, and so every sample produced identical
        // output: picking "deliberate 9 degree error" showed the same 1.8 degrees as "perfect".
        // The five files under wwwroot/samples carry known injected errors, which is the whole
        // point of them — the measured number has to move when the drawing does.
        IsAnalyzing = true;
        AnalysisCompleted = false;
        ClearAnalysis();

        var path = Path.Combine(Env.WebRootPath, "samples", filename);
        CurrentBase64 = File.Exists(path)
            ? Convert.ToBase64String(await File.ReadAllBytesAsync(path))
            : string.Empty;

        // The calibration set now holds both kinds, so the sample decides which reference it is
        // measured against. Measuring an isometric cube as if it were perspective would find a
        // vanishing point among edges that were never meant to meet.
        var axonometricSystem = AxonometricSystemForSample(filename);
        if (axonometricSystem is not null)
        {
            CurrentAxonometry = await AgentClient.AnalyzeAxonometricAsync(CurrentBase64, axonometricSystem);
            AgentUnavailable = CurrentAxonometry is null;
        }
        else
        {
            var kPoints = filename.StartsWith("04") || filename.StartsWith("05") ? 2 : 1;
            CurrentGeometry = await AgentClient.AnalyzeGeometryAsync(CurrentBase64, kPoints, generateOverlay: true);
            AgentUnavailable = CurrentGeometry is null;
        }

        IsAnalyzing = false;
    }

    /// <summary>Which projection system a calibration sample was drawn in, or null for conic.</summary>
    private static string? AxonometricSystemForSample(string filename) => filename switch
    {
        "06_isometric_perfect.png" => "isometric",
        "07_isometric_error_6deg.png" => "isometric",
        "08_cavalier_perfect.png" => "cavalier",
        _ => null,
    };

    /// <summary>
    /// Drop every measurement from the previous drawing. Leaving one behind is how a refused
    /// upload came to display the confidence score of the drawing before it.
    /// </summary>
    private void ClearAnalysis()
    {
        CurrentGeometry = null;
        CurrentAxonometry = null;
        CurrentCritique = null;
        ExerciseSaved = false;
        IntentMismatch = false;
        NotAnExercise = null;
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        CurrentBase64 = Convert.ToBase64String(ms.ToArray());

        IsAnalyzing = true;
        AnalysisCompleted = false;
        ClearAnalysis();

        // The gate first. A photograph that is not a perspective exercise — a page of text, a
        // blank sheet, a picture of the cat — would otherwise go through RANSAC, produce a
        // vanishing point from whatever edges exist, and earn a critique about line weight.
        // Measuring the wrong thing carefully is worse than not measuring it.
        var gate = await AgentClient.ClassifyDrawingAsync(CurrentBase64);
        if (gate is { IsExercise: false })
        {
            NotAnExercise = gate.Reasoning;
            AnalysisCompleted = false;
            IsAnalyzing = false;
            return;
        }

        // The gate does not only decide whether to measure; it decides what to measure against.
        // A parallel projection has no vanishing point, so running it through the perspective
        // path would produce a confident number about a point that does not exist in the drawing.
        // Only a gate that actually looked gets to make that call — the fallback stays conic,
        // which is the behaviour this page has always had.
        if (gate is { Source: "vertex", Projection: "axonometric" } && gate.AxonometricSystem is { Length: > 0 } system)
        {
            CurrentAxonometry = await AgentClient.AnalyzeAxonometricAsync(CurrentBase64, system);
            AgentUnavailable = CurrentAxonometry is null;
        }
        else
        {
            var kPoints = gate is { Source: "vertex", RecommendedK: 1 or 2 }
                ? gate.RecommendedK
                : (CurrentStudent?.Level == "beginner" ? 1 : 2);

            CurrentGeometry = await AgentClient.AnalyzeGeometryAsync(CurrentBase64, kPoints, generateOverlay: true);
            AgentUnavailable = CurrentGeometry is null;
        }

        IsAnalyzing = false;
    }

    private async Task HandleAskCompleted((string Intent, string Difficulty) context)
    {
        if (!HasAnalysis || CurrentStudent == null) return;

        IsAnalyzing = true;
        ExerciseSaved = false;

        // Ask the router what the student's own words imply, and compare it with what the drawing
        // was actually measured as.
        //
        // The words do NOT win. An earlier version re-measured on the router's say-so, and a
        // one-point box described as "the corner of a building" came back as two-point: 29.9
        // degrees of average error, 89.2 on the worst line, two vanishing points found in a
        // drawing that has one. That is this project's own principle broken — the measurement is
        // the evidence and the description is a claim, so the claim does not overrule it.
        //
        // What the disagreement is good for is saying so. "You described a corner; this reads as
        // one-point" is useful to a student in a way that neither signal is alone.
        Routing = await AgentClient.RouteIntentAsync(context.Intent, CurrentStudent.Level);
        IntentMismatch = Routing is { Source: "gemma", RecommendedK: 1 or 2 }
                         && CurrentGeometry is not null
                         && Routing.RecommendedK != CurrentGeometry.KRequested;

        var critiqueReq = new CritiqueRequestDto
        {
            // Exactly one of the two. The agent refuses a request carrying both, because the
            // anti-hallucination whitelist would then be the union of two unrelated sets of
            // numbers and a figure invented for one drawing could match a figure from the other.
            Geometry = CurrentGeometry,
            Axonometry = CurrentAxonometry,
            Student = CurrentStudent,
            // The drawing itself. Plane B asks the model about line weight and spatial clarity;
            // without the image the validator rejects those observations, retries three times,
            // and falls back to the template — which is what happened, silently, until this line.
            ImageBase64 = CurrentBase64,
            StudentIntent = context.Intent,
            StudentDifficulty = context.Difficulty,
            // Off by default. Under a rule that mandates an unedited live execution, demoing a
            // disk read is not demoing an agent — and a cached critique cannot be about the
            // drawing that was just uploaded.
            UseCache = false
        };

        var response = await AgentClient.GenerateCritiqueAsync(critiqueReq);
        CurrentCritique = response?.Critique;
        AgentUnavailable = CurrentCritique is null;

        // Persist the exercise and adopt the id the agent gives back. This is what makes the
        // feedback step real: the id used to be minted here and never sent, so every thumbs-up
        // arrived for an exercise the agent had never heard of.
        if (CurrentCritique is not null)
        {
            var saved = await AgentClient.SaveExerciseAsync(new ExerciseRecordDto
            {
                ExerciseId = $"ex-ui-{Guid.NewGuid().ToString("N")[..8]}",
                StudentId = CurrentStudent.StudentId,
                Source = "upload",
                StudentIntent = context.Intent,
                StudentDifficulty = context.Difficulty,
                GeometryAnalysis = CurrentGeometry,
                AxonometricAnalysis = CurrentAxonometry,
                Critique = CurrentCritique
            });

            CurrentExerciseId = saved?.ExerciseId ?? string.Empty;
            ExerciseSaved = saved is not null;
        }

        IsAnalyzing = false;
        AnalysisCompleted = true;
    }
}
