@using System.Globalization
﻿<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-bs-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Atelier.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <script>
        // Applied before first paint so the page never flashes the wrong theme. Bootstrap 5.3
        // reads data-bs-theme on <html>; "system" defers to the operating system, which is the
        // default because a tool for looking at drawings should not override what the person
        // already chose for their screen.
        (function () {
            var stored = localStorage.getItem('atelier-theme') || 'system';
            var resolved = stored === 'system'
                ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
                : stored;
            document.documentElement.setAttribute('data-bs-theme', resolved);
            window.atelierSetTheme = function (choice) {
                localStorage.setItem('atelier-theme', choice);
                var r = choice === 'system'
                    ? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
                    : choice;
                document.documentElement.setAttribute('data-bs-theme', r);
                return r;
            };
            window.atelierGetTheme = function () { return localStorage.getItem('atelier-theme') || 'system'; };

            // The rail's width is remembered the same way and for the same reason: someone who
            // collapsed it once should not have to collapse it again on every page.
            window.atelierSetRailCollapsed = function (collapsed) {
                localStorage.setItem('atelier-rail-collapsed', collapsed ? '1' : '0');
            };
            window.atelierGetRailCollapsed = function () {
                return localStorage.getItem('atelier-rail-collapsed') === '1';
            };
        })();
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
