@namespace Atelier.Web.Components.Shared

<div class="progress-chart">
    @if (Profile == null)
    {
        <div class="p-4 text-center text-muted">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2">@Loc["Loading student progression..."]</p>
        </div>
    }
    else
    {
        <!-- Header Metrics -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-tertiary text-body text-center">
                    <small class="text-body-secondary d-block">@Loc["Overall Avg Error"]</small>
                    <strong class="fs-3 text-primary">@(Profile.OverallAvgErrorDeg is double avg ? $"{avg:F1}°" : "—")</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-tertiary text-body text-center">
                    <small class="text-body-secondary d-block">@Loc["Total Drawings"]</small>
                    <strong class="fs-3 text-info">@Profile.TotalExercises</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-tertiary text-body text-center">
                    <small class="text-body-secondary d-block">@Loc["Adapted Tone"]</small>
                    <strong class="fs-3 text-warning metric-label">@Loc[Profile.DerivedTonePreference]</strong>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-body-tertiary text-body text-center">
                    <small class="text-body-secondary d-block">@Loc["Helpful Ratio"]</small>
                    <strong class="fs-3 text-success">@Profile.RecentHelpfulRatio.ToString("P0")</strong>
                </div>
            </div>
        </div>

        <!-- Convergence Error Progression Curve (Native SVG) -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-body-tertiary text-body mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold text-body mb-0">@Loc["📈 Convergence Error Progression"]</h5>
                    <small class="text-body-secondary">@Loc["Angular deviation over sequential drawing sessions (lower is better)"]</small>
                </div>
                <span class="badge bg-primary px-3 py-2 rounded-pill font-monospace">
                    @Loc["Deterministic Metric"]
                </span>
            </div>

            @if (Profile.ProgressCurve != null && Profile.ProgressCurve.Count > 1)
            {
                <div class="w-100 py-3" style="height: 220px;">
                    <svg viewBox="0 0 600 180" class="w-100 h-100 overflow-visible">
                        <!-- Grid lines -->
                        <line x1="40" y1="20" x2="580" y2="20" stroke="#334155" stroke-dasharray="3" stroke-width="1" />
                        <line x1="40" y1="70" x2="580" y2="70" stroke="#334155" stroke-dasharray="3" stroke-width="1" />
                        <line x1="40" y1="120" x2="580" y2="120" stroke="#334155" stroke-dasharray="3" stroke-width="1" />
                        <line x1="40" y1="160" x2="580" y2="160" stroke="#64748b" stroke-width="1.5" />

                        <!-- Labels -->
                        <text x="10" y="25" fill="#94a3b8" font-size="10">6°</text>
                        <text x="10" y="75" fill="#94a3b8" font-size="10">4°</text>
                        <text x="10" y="125" fill="#94a3b8" font-size="10">2°</text>
                        <text x="10" y="165" fill="#94a3b8" font-size="10">0°</text>

                        <!-- Polyline for progress curve -->
                        @{
                            var points = Profile.ProgressCurve;
                            var maxErr = 8.0;
                            var xStep = points.Count > 1 ? 520.0 / (points.Count - 1) : 520.0;
                            var polylinePoints = "";
                            for (int i = 0; i < points.Count; i++)
                            {
                                var px = 50 + (i * xStep);
                                var py = 160 - (Math.Min(points[i].AvgConvergenceErrorDeg, maxErr) / maxErr * 140);
                                polylinePoints += $"{px.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{py.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)} ";
                            }
                        }

                        <polyline fill="none" stroke="#06b6d4" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="@polylinePoints.Trim()" />

                        <!-- Data point circles -->
                        @for (int i = 0; i < points.Count; i++)
                        {
                            var px = 50 + (i * xStep);
                            var py = 160 - (Math.Min(points[i].AvgConvergenceErrorDeg, maxErr) / maxErr * 140);
                            <g>
                                <circle cx="@px.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@py.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" r="5" fill="#f59e0b" stroke="#0f172a" stroke-width="2" />
                                <text x="@((px - 10).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))" y="@((py - 10).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))" fill="#f8fafc" font-size="11" font-weight="bold">
                                    @points[i].AvgConvergenceErrorDeg.ToString("F1")°
                                </text>
                            </g>
                        }
                    </svg>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <p>@Loc["More session data needed to render full progression curve."]</p>
                </div>
            }
        </div>

        <!-- Weekly Practice Plan from Cloud Scheduler Digest (ADR-004) -->
        @if (Digest?.NextWeekPracticePlan != null && Digest.NextWeekPracticePlan.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-body-tertiary text-body mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-warning mb-0">@Loc["📅 Prescribed Weekly Practice Plan"]</h5>
                        <small class="text-body-secondary">@(Loc["Synthesized by Cloud Scheduler weekly digest (Week {0})", Digest.WeekId])</small>
                    </div>
                    <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">
                        @Digest.WeekId
                    </span>
                </div>

                <div class="row g-3">
                    @foreach (var dayPlan in Digest.NextWeekPracticePlan)
                    {
                        <div class="col-md-4">
                            <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary-subtle border-opacity-25 h-100">
                                <span class="badge bg-primary rounded-pill mb-2">@dayPlan.Day</span>
                                <h6 class="text-body fw-bold mb-1">@dayPlan.Title</h6>
                                <p class="text-body-secondary small mb-2">@dayPlan.Description</p>
                                <small class="text-info d-block">@(Loc["Target: {0}", dayPlan.TargetMetric])</small>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public DerivedProfileDto? Profile { get; set; }

    [Parameter]
    public WeeklyDigestDto? Digest { get; set; }
}
