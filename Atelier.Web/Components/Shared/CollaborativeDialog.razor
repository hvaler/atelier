@namespace Atelier.Web.Components.Shared
@inject IAtelierAgentClient AgentClient

<div class="collaborative-dialog card border-0 shadow-sm rounded-4 p-4 bg-body-tertiary text-body mb-4">
    @if (Mode == "ask")
    {
        <!-- Verb 1: ASK Clarifying Questions -->
        <div class="d-flex align-items-center gap-2 mb-3">
            <span class="fs-4">💬</span>
            <div>
                <h5 class="fw-bold text-primary mb-0">@Loc["Studio Master Collaboration (ASK)"]</h5>
                <small class="text-body-secondary">@Loc["Tell Atelier about your practice focus before analyzing"]</small>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label text-body fw-bold small">@AskData?.IntentQuestion</label>
            <textarea rows="2" class="form-control bg-body-secondary text-body border-secondary-subtle mb-2" placeholder="@IntentPlaceholder" @bind="IntentInput"></textarea>
            <div class="d-flex flex-wrap gap-2">
                @if (AskData?.QuickIntentSuggestions != null)
                {
                    @foreach (var sug in AskData.QuickIntentSuggestions)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 text-body-secondary" @onclick="() => IntentInput = sug">
                            + @sug
                        </button>
                    }
                }
            </div>
        </div>

        <div class="mb-4">
            <label class="form-label text-body fw-bold small">@AskData?.DifficultyQuestion</label>
            <textarea rows="2" class="form-control bg-body-secondary text-body border-secondary-subtle mb-2" placeholder="@DifficultyPlaceholder" @bind="DifficultyInput"></textarea>
            <div class="d-flex flex-wrap gap-2">
                @if (AskData?.QuickDifficultySuggestions != null)
                {
                    @foreach (var sug in AskData.QuickDifficultySuggestions)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill py-0 px-2 text-body-secondary" @onclick="() => DifficultyInput = sug">
                            + @sug
                        </button>
                    }
                }
            </div>
        </div>

        <button type="button" class="btn btn-primary w-100 py-2 rounded-pill fw-bold" @onclick="SubmitAskContext">
            @Loc["Analyze Drawing with My Context 🚀"]
        </button>
    }
    else if (Mode == "feedback")
    {
        <!-- Verb 3: CAPTURE & Verb 4: ADAPT -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h6 class="fw-bold text-body mb-0">@Loc["Was this critique helpful? (CAPTURE & ADAPT)"]</h6>
                <small class="text-body-secondary">@Loc["Your feedback automatically adapts the agent's tone and exercises"]</small>
            </div>
            @if (FeedbackSubmitted && AdaptedProfile is not null)
            {
                <span class="badge bg-success px-3 py-2 rounded-pill">
                    @(Loc["Profile Adapted ✓ — tone: {0}", Loc[AdaptedProfile.DerivedTonePreference]])
                </span>
            }
            else if (FeedbackError is not null)
            {
                <span class="badge bg-danger px-3 py-2 rounded-pill">@FeedbackError</span>
            }
        </div>

        @if (!FeedbackSubmitted)
        {
            <div class="d-flex gap-2 mb-3">
                <button type="button" class="btn @(HelpfulChoice == true ? "btn-success" : "btn-outline-success") rounded-pill px-4" @onclick="() => HelpfulChoice = true">
                    @Loc["👍 Helpful"]
                </button>
                <button type="button" class="btn @(HelpfulChoice == false ? "btn-warning" : "btn-outline-warning") rounded-pill px-4" @onclick="() => HelpfulChoice = false">
                    @Loc["👎 Needs Adjustment"]
                </button>
            </div>

            @if (HelpfulChoice.HasValue)
            {
                <div class="mb-3">
                    <textarea rows="2" class="form-control bg-body-secondary text-body border-secondary-subtle form-control-sm" placeholder="@NotePlaceholder" @bind="FeedbackNote"></textarea>
                </div>
                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4" @onclick="SubmitFeedback">
                    @Loc["Submit Feedback & Update Profile"]
                </button>
            }
        }
        else
        {
            <div class="alert alert-dark bg-secondary bg-opacity-10 border border-secondary-subtle border-opacity-25 text-body mb-0 small">
                @Loc["✓ Thank you! Atelier has recorded this event in your append-only profile history and calibrated future critique depth."]
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public string Mode { get; set; } = "ask"; // "ask" or "feedback"

    [Parameter]
    public AskPromptDataDto? AskData { get; set; }

    [Parameter]
    public string? ExerciseId { get; set; }

    [Parameter]
    public string StudentId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<(string Intent, string Difficulty)> OnAskCompleted { get; set; }

    // Placeholders live here rather than inline: two of them carry apostrophes, which a
    // single-quoted Razor attribute cannot hold.
    private string IntentPlaceholder => Loc["e.g. 1-Point box or 2-Point building..."];
    private string DifficultyPlaceholder => Loc["e.g. Converging the top lines or line weight..."];
    private string NotePlaceholder =>
        Loc["Optional note: (e.g. 'Tone was a bit too technical' or 'Loved the focus area')"];

    private string IntentInput { get; set; } = string.Empty;
    private string DifficultyInput { get; set; } = string.Empty;

    private bool? HelpfulChoice { get; set; }
    private string FeedbackNote { get; set; } = string.Empty;
    private bool FeedbackSubmitted { get; set; }

    private async Task SubmitAskContext()
    {
        await OnAskCompleted.InvokeAsync((IntentInput, DifficultyInput));
    }

    private async Task SubmitFeedback()
    {
        if (!HelpfulChoice.HasValue || string.IsNullOrEmpty(ExerciseId))
            return;

        // Only claim the profile adapted if the agent says it stored the event. This line used
        // to be unconditional: the client returned its own request payload whether the call had
        // succeeded or 404'd, so the badge appeared over an append-only store that had appended
        // nothing.
        FeedbackSubmitted = await AgentClient.SubmitFeedbackAsync(
            ExerciseId, StudentId, HelpfulChoice.Value, FeedbackNote);

        if (FeedbackSubmitted)
        {
            // Read the profile back and show what actually changed, rather than asserting that
            // something did.
            AdaptedProfile = await AgentClient.GetDerivedProfileAsync(StudentId);
        }
        else
        {
            FeedbackError = Loc["The agent did not record that. Nothing was changed."];
        }
    }

    private DerivedProfileDto? AdaptedProfile { get; set; }
    private string? FeedbackError { get; set; }
}
