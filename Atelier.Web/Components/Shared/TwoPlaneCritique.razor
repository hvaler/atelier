@namespace Atelier.Web.Components.Shared

<div class="two-plane-critique">
    @if (Critique == null)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center text-muted">
            <p>@Loc["Critique will appear once drawing is analyzed."]</p>
        </div>
    }
    else
    {
        <!-- Headline Card -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-body p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="badge bg-white text-primary rounded-pill px-3 py-1 mb-2">
                        @(Loc["{0} LEVEL CRITIQUE", Loc[Critique.Level].Value.ToUpperInvariant()])
                    </span>
                    <h3 class="fw-bold mb-1">@Critique.Headline</h3>
                    <p class="mb-0 text-body-secondary small">@(Loc["Critique tailored for {0} • Grounded strictly on OpenCV (ADR-001)", Critique.StudentName])</p>
                </div>
                <div>
                    @* The green badge is earned, not decorative. It used to render over the
                       deterministic studio template, which no model produced and which stamped
                       itself validated=true — so deleting Vertex AI from the project would have
                       changed nothing visible on this screen. *@
                    @if (Critique.Source == "vertex" && Critique.Validated)
                    {
                        <span class="badge bg-success bg-opacity-75 px-3 py-2 rounded-pill font-monospace small">
                            @Loc["Anti-Hallucination: Validated ✓"]
                        </span>
                        <div class="text-body-secondary small mt-1 font-monospace">@Critique.ModelVersion</div>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill font-monospace small">
                            @Loc["Deterministic fallback — no model answered"]
                        </span>
                        <div class="text-body-secondary small mt-1 font-monospace">@Critique.ModelVersion</div>
                    }
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- Plane A: Quantitative Measured Findings -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-body-tertiary text-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="fs-4">📐</span>
                        <div>
                            <h5 class="fw-bold mb-0 text-primary">@Loc["Plane A: Measured Findings"]</h5>
                            <small class="text-body-secondary">@Loc["Deterministic OpenCV Metrics (ADR-001)"]</small>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @if (Critique.MeasuredFindings != null && Critique.MeasuredFindings.Count > 0)
                        {
                            @foreach (var item in Critique.MeasuredFindings)
                            {
                                <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary-subtle border-opacity-25">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-body metric-label">@Loc[item.MetricName.Replace('_', ' ')]</strong>
                                        <span class="badge bg-primary px-2 py-1 font-monospace">
                                            @item.MeasuredValue.ToString(item.Unit == "degrees" ? "F1" : "F0") @Loc[item.Unit]
                                        </span>
                                    </div>
                                    <p class="text-body-secondary small mb-0">@item.PedagogicalContext</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">@Loc["No quantitative deviations recorded."]</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Plane B: Studio Master Qualitative Observations -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-body-tertiary text-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="fs-4">🖌️</span>
                        <div>
                            <h5 class="fw-bold mb-0 text-warning">@Loc["Plane B: Studio Observations"]</h5>
                            <small class="text-body-secondary">@Loc["Line weight, spatial clarity & cleanliness (RUNBOOK §2)"]</small>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3">
                        @if (Critique.QualitativeObservations != null && Critique.QualitativeObservations.Count > 0)
                        {
                            @foreach (var item in Critique.QualitativeObservations)
                            {
                                <div class="p-3 rounded-3 bg-secondary bg-opacity-10 border border-secondary-subtle border-opacity-25">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-body metric-label">@Loc[item.Aspect.Replace('_', ' ')]</strong>
                                        <span class="badge @(item.Status == "strength" ? "bg-success" : item.Status == "proficient" ? "bg-info" : "bg-warning text-dark") px-2 py-1">
                                            @Loc[item.Status].Value.ToUpperInvariant()
                                        </span>
                                    </div>
                                    <p class="text-body-secondary small mb-0">@item.Observation</p>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small">@Loc["No qualitative observations available."]</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Pedagogical Summary & Focus Area -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-body-tertiary text-body">
            <h5 class="fw-bold text-body mb-3">@Loc["🎯 Master's Summary & Next Focus"]</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                        <strong class="text-success d-block mb-2">@Loc["Strengths Highlighted:"]</strong>
                        <ul class="mb-0 text-body-secondary ps-3 small">
                            @foreach (var str in Critique.PedagogicalSummary.Strengths)
                            {
                                <li>@str</li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25">
                        <strong class="text-warning d-block mb-1">@Loc["Single Focus Area:"]</strong>
                        <p class="text-body-secondary small mb-0">@Critique.PedagogicalSummary.FocusArea</p>
                    </div>
                </div>
            </div>

            <div class="mt-3 p-3 rounded-3 bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 text-center">
                <span class="fst-italic">"@Critique.PedagogicalSummary.Encouragement"</span>
            </div>
        </div>

        <!-- Next Prescribed Exercise (Verb 2: GUIDE) -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-body-tertiary text-body border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="fw-bold text-primary mb-0">@Loc["🚀 Prescribed Next Exercise (GUIDE)"]</h5>
                <span class="badge bg-primary px-3 py-1 rounded-pill">
                    @Loc[Critique.NextExercise.Difficulty].Value.ToUpperInvariant()
                </span>
            </div>
            <h6 class="text-body fw-bold">@Critique.NextExercise.Title</h6>
            <p class="text-body-secondary small mb-2">@Critique.NextExercise.Description</p>
            <div class="small text-body-secondary">
                @Loc["Target Metric:"] <span class="text-info">@Critique.NextExercise.TargetMetric</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public CritiqueOutputDto? Critique { get; set; }
}
