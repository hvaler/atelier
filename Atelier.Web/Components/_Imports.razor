@using System.Net.Http
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@using Atelier.Web
@using Atelier.Web.Components
@using Atelier.Web.Components.Layout
@using Atelier.Web.Models
@using Atelier.Web.Services
@using Microsoft.Extensions.Localization

@* Injected here rather than per-component: every product page has user-visible prose, and a
   per-file @inject line is one more thing to forget when a new page is added. `Loc` is short
   on purpose — it appears roughly eighty times in markup and a longer name would fight the
   surrounding HTML for legibility. *@
@inject IStringLocalizer<SharedResource> Loc
