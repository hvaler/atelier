@* The rail. Icons carry the navigation and labels explain it; when the rail is collapsed the
   labels go and the icons stay, which is the only arrangement where collapsing gains space
   without losing the ability to navigate. Each link keeps its label as a title attribute so the
   collapsed state is still usable rather than merely compact. *@
<div class="rail-brand">
    <a href="" class="brand">
        <span class="brand-mark" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                <circle cx="14" cy="6" r="2" fill="currentColor" />
                <path d="M1 6h11M2 17l11-9M8 17l6-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
        </span>
        @if (!Collapsed)
        {
            <span class="brand-text">Atelier</span>
        }
    </a>
</div>

<nav class="rail-nav">
    @foreach (var item in Items)
    {
        <NavLink class="rail-link" href="@item.Href" Match="@item.Match" title="@Loc[item.LabelKey]">
            <span class="rail-icon" aria-hidden="true">@((MarkupString)item.Icon)</span>
            @if (!Collapsed)
            {
                <span class="rail-text">@Loc[item.LabelKey]</span>
            }
        </NavLink>
    }
</nav>

@code {
    [Parameter]
    public bool Collapsed { get; set; }

    private sealed record NavItem(string Href, NavLinkMatch Match, string LabelKey, string Icon);

    // Line-drawing icons rather than emoji: emoji render at a different weight and colour on every
    // platform, and a rail of them looks like a different product on each machine.
    private static readonly NavItem[] Items =
    [
        new("", NavLinkMatch.All, "Studio Workspace",
            """<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 15h14M4 15V7l5-4 5 4v8" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>"""),
        new("progress", NavLinkMatch.Prefix, "Student Progression",
            """<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 15h14M3 12l4-4 3 3 5-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>"""),
        new("gallery", NavLinkMatch.Prefix, "Calibration Gallery",
            """<svg width="18" height="18" viewBox="0 0 18 18" fill="none"><rect x="2.5" y="3.5" width="13" height="11" rx="1.5" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 11l3.5-3 3 2.5L12 7l3.5 3" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>"""),
    ];
}
