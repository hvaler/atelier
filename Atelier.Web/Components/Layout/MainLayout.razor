@inherits LayoutComponentBase
@using Atelier.Web.Components.Shared

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex align-items-center gap-3">
            @* This was the Blazor template's link to Microsoft's ASP.NET docs, still pointing
               there on a submitted demo. "About" on a judged project should go to the project. *@
            <a href="https://github.com/hvaler/atelier" target="_blank" rel="noopener">@Loc["About Atelier"]</a>
            <a href="https://github.com/hvaler/atelier/blob/main/docs/PEDAGOGY.md" target="_blank" rel="noopener">@Loc["How it grades"]</a>

            @* Both controls sit together at the far right: they are the two things about this page
               a person changes once and then forgets. *@
            <div class="ms-auto d-flex align-items-center gap-2">
                <CulturePicker />
                <ThemeToggle />
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Loc["An unhandled error has occurred."]
    <a href="." class="reload">@Loc["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
